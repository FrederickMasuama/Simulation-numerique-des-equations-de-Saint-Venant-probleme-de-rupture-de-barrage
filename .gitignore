# ==================================================
# COMPILATION FORTRAN / C / C++
# ==================================================

# Fichiers objets
*.o
*.obj

# Modules Fortran
*.mod
*.smod

# Bibliothèques compilées
*.a
*.so
*.dll
*.dylib

# Exécutables générés
# Convention : les exécutables sont placés dans bin/
**/bin/*


# ==================================================
# DONNEES GENEREES PAR LES SIMULATIONS
# ==================================================

# Fichiers intermédiaires des animations
**/data/frame_*.dat
**/data/nb_frames*.dat

# Solutions numériques générées
**/data/solution*.dat
**/data/comparaison*.dat

# Fichiers de paramètres générés automatiquement pour les tracés
**/data/parametres_plot.dat


# ==================================================
# FICHIERS TEMPORAIRES
# ==================================================

*.log
*.tmp
*~
*.bak
*.swp
*.swo

# Fichiers temporaires de certains éditeurs
.DS_Store
Thumbs.db


# ==================================================
# ENVIRONNEMENTS ET OUTILS
# ==================================================

# Dossiers de compilation
**/obj/

# Configuration locale de certains éditeurs
.vscode/
